{
    "compilerOptions": {
        "target": "es2020",
        "module": "es2020",
        "moduleResolution": "bundler",
        "strict": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "isolatedModules": true,
        "typeRoots": ["./node_modules/@types", "./types"]
    },
    "include": [
        "./src/**/*",
        "./scripts/**/*",
        "./types/**/*.d.ts"
    ],
}